# EditorConfig — https://editorconfig.org
# Baseline whitespace rules shared by every editor. The authoritative
# formatters remain ruff (Python, line length 100 — see CLAUDE.md §4.3) and
# prettier (TypeScript/JSON/Markdown); this file only keeps editors from
# fighting them.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

[*.{json,jsonc,yml,yaml,css,html,md}]
indent_size = 2

[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
