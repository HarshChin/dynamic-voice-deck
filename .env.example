# ---------------------------------------------------------------------------
# Dynamic Voice Deck — environment configuration
# Copy to `.env` and fill in GROQ_API_KEY. Every variable below is optional
# except that one; the defaults shown are the values used when unset.
# Field names mirror `backend/app/config.py` (Settings) exactly.
# ---------------------------------------------------------------------------

# --- Credentials -----------------------------------------------------------
# Free tier, no card required: https://console.groq.com
GROQ_API_KEY=

# --- Provider selection ----------------------------------------------------
# stt: groq (Whisper large-v3-turbo) | local (faster-whisper) | fake
# llm: groq (gpt-oss-120b)           | ollama                 | fake
# tts: kokoro (Kokoro-82M, on-device) | fake
#
# PHASE GATING: the milestone in progress is M1, the text loop, which needs only
# Every stage can be swapped independently. `fake` is the in-repository double
# used by the tests and the end-to-end suite; it needs no network and no key.
STT_PROVIDER=groq
LLM_PROVIDER=groq
TTS_PROVIDER=kokoro

# Answer on a second model when the first is rate limited (TR-085).
#
# The hosted model is the only stage with a token budget, and the free tier's is
# reachable in normal use: a handful of questions in quick succession exhausts
# the per-minute ceiling. `none` leaves the previous behaviour, where the turn
# fails and the UI counts down. `ollama` answers anyway, on this machine, four to
# six times slower, and the UI says which model spoke.
#
# Off by default because it needs Ollama installed and a model pulled, and a
# fresh clone should not silently require a 5 GB download:
#
#     brew install ollama && ollama serve
#     ollama pull qwen2.5:7b
#
LLM_FALLBACK_PROVIDER=none

# --- Model identifiers -----------------------------------------------------
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Same family as the hosted default, and deliberately not qwen3: its thinking
# mode spends the token budget before it says anything, which is exactly the
# failure that got gpt-oss-120b rejected (docs/EVALS.md).
OLLAMA_MODEL=qwen2.5:7b

# --- Generation tuning -----------------------------------------------------
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=350
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- Server ----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON list only. pydantic-settings JSON-decodes complex-typed fields, so a
# bare comma-separated value raises SettingsError at startup.
# Defaults already cover the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Observability ---------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG | NOTSET
LOG_LEVEL=INFO
# Set true for machine-readable JSON logs instead of coloured console output.
LOG_JSON=false

# --- Pipeline tuning -------------------------------------------------------
# Watchdog that returns a stuck turn to LISTENING (TRD TR-025).
TURN_TIMEOUT_S=20.0
# Conversation turns retained before dropping oldest-first (TRD TR-052).
MAX_HISTORY_TURNS=20
# WebSocket frame limits (TRD TR-182).
MAX_JSON_MESSAGE_BYTES=16384
MAX_UTTERANCE_BYTES=2097152
